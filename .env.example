# 복사해서 사용: cp .env.example .env  (.env 는 커밋 금지)
# docker compose 와 backend(bootRun) 가 모두 이 파일을 읽는다.

# --- DB (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=live
DB_USERNAME=live
DB_PASSWORD=live

# --- 인증 ---
# HS256 서명 키, 32바이트 이상. 비우면 기동할 때마다 임의 생성(재시작 시 로그인 풀림).
# 생성 예: openssl rand -base64 48
JWT_SECRET=
# Refresh 쿠키. 프론트와 API 도메인이 다르면(배포) COOKIE_SECURE=true, COOKIE_SAME_SITE=None
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# 프론트 주소(쉼표로 여러 개)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 테스트 계정(streamer@demo.test / viewer@demo.test) 비밀번호
DEMO_PASSWORD=demo1234!

# --- LiveKit (Cloud 대시보드 → Settings → Keys) ---
# 비어 있으면 토큰 발급·웹훅 API만 503 LIVEKIT_NOT_CONFIGURED, 나머지는 정상 동작
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
